<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pakistan Accounting ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <aside class="auth-showcase">
            <div id="loginShowcase" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4500" data-bs-pause="hover">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#loginShowcase" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#loginShowcase" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#loginShowcase" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    <button type="button" data-bs-target="#loginShowcase" data-bs-slide-to="3" aria-label="Slide 4"></button>
                    <button type="button" data-bs-target="#loginShowcase" data-bs-slide-to="4" aria-label="Slide 5"></button>
                    <button type="button" data-bs-target="#loginShowcase" data-bs-slide-to="5" aria-label="Slide 6"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="~/img/login/yt-01-open.jpg" alt="Pakistan Accounting ERP" asp-append-version="true" />
                    </div>
                    <div class="carousel-item">
                        <img src="~/img/login/yt-02-benefits.jpg" alt="One system for the whole business" asp-append-version="true" />
                    </div>
                    <div class="carousel-item">
                        <img src="~/img/login/yt-03-sales-fbr.jpg" alt="Sales, tax and FBR invoicing" asp-append-version="true" />
                    </div>
                    <div class="carousel-item">
                        <img src="~/img/login/yt-04-ops.jpg" alt="Purchase, stock, banking and reports" asp-append-version="true" />
                    </div>
                    <div class="carousel-item">
                        <img src="~/img/login/yt-05-customization.jpg" alt="Customer-based customization" asp-append-version="true" />
                    </div>
                    <div class="carousel-item">
                        <img src="~/img/login/yt-07-cta.jpg" alt="Call or WhatsApp for a live walkthrough" asp-append-version="true" />
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#loginShowcase" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#loginShowcase" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
            <div class="auth-showcase-contact">
                <a class="auth-phone" href="https://wa.me/923006404712" target="_blank" rel="noopener">
                    <i class="fa-brands fa-whatsapp"></i>
                    +92 300 6404712
                </a>
                <a class="auth-phone-call" href="tel:+923006404712">
                    <i class="fa-solid fa-phone"></i>
                    Call
                </a>
            </div>
        </aside>

        <div class="auth-wrapper">
            @RenderBody()
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
