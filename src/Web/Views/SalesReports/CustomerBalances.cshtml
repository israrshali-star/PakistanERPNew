@{
    ViewData["Title"] = "Customer Balances";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3 no-print">
    <div>
        <h4 class="text-primary mb-1">Customer Balances</h4>
        <p class="text-muted small mb-0">Customer debit and credit balances for a date range. Balances of 1,000 or less are hidden.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm" id="btn-print-report">
            <i class="fa-solid fa-print me-1"></i>Print
        </button>
        <button type="button" class="btn btn-outline-danger btn-sm" id="btn-pdf-report">
            <i class="fa-solid fa-file-pdf me-1"></i>PDF
        </button>
        <button type="button" class="btn btn-success btn-sm" id="btn-whatsapp-report">
            <i class="fa-brands fa-whatsapp me-1"></i>WhatsApp
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div id="report-company-warning" class="alert alert-warning d-none mb-3 no-print"></div>

<div class="card p-3 mb-3 no-print">
    <div class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label" for="filter-from">From Date</label>
            <input type="date" class="form-control" id="filter-from" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="filter-to">To Date</label>
            <input type="date" class="form-control" id="filter-to" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="filter-customer">Customer</label>
            <select class="form-select select2" id="filter-customer">
                <option value="">All customers</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-primary w-100" id="btn-load-report">
                <i class="fa-solid fa-magnifying-glass me-1"></i>Load
            </button>
        </div>
    </div>
</div>

<div class="card p-3 report-print-area report-print-landscape" id="report-content">
    <div class="text-center mb-4">
        <h5 class="text-primary mb-1">Customer Balances</h5>
        <p class="text-muted small mb-0" id="report-company-name"></p>
        <p class="text-muted small mb-0" id="report-period">Select dates and click Load</p>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th>Customer Code</th>
                    <th>Customer Name</th>
                    <th class="text-end">Opening Dr</th>
                    <th class="text-end">Opening Cr</th>
                    <th class="text-end">Period Dr</th>
                    <th class="text-end">Period Cr</th>
                    <th class="text-end">Closing Dr</th>
                    <th class="text-end">Closing Cr</th>
                </tr>
            </thead>
            <tbody id="report-lines">
                <tr><td colspan="8" class="text-muted text-center">No data loaded.</td></tr>
            </tbody>
            <tfoot id="report-footer" class="d-none table-light">
                <tr>
                    <th colspan="2" class="text-end">Totals</th>
                    <th class="text-end" id="report-total-opening-debit">0.00</th>
                    <th class="text-end" id="report-total-opening-credit">0.00</th>
                    <th class="text-end" id="report-total-period-debit">0.00</th>
                    <th class="text-end" id="report-total-period-credit">0.00</th>
                    <th class="text-end" id="report-total-closing-debit">0.00</th>
                    <th class="text-end" id="report-total-closing-credit">0.00</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Styles {
    <style>
        @@media print {
            @@page { size: A4 landscape; margin: 10mm; }
        }
    </style>
}

@section Scripts {
    <script src="~/js/modules/sales-report-customer-balances.js" asp-append-version="true"></script>
}
