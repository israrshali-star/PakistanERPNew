@model PakistanAccountingERP.Application.DTOs.CustomerLedgerDto
@using PakistanAccountingERP.Application.Interfaces.Services
@inject IPermissionService PermissionService
@{
    ViewData["Title"] = "Customer Ledger";
    var canViewInvoice = await PermissionService.HasPermissionAsync("Sales.View");
    var canOpenReceipt = canViewInvoice
        || await PermissionService.HasPermissionAsync("Sales.Edit");
    var canEditReceipt = await PermissionService.HasPermissionAsync("Sales.Edit");
    var showRowActions = canViewInvoice || canOpenReceipt;
    var receiptReturnUrl = Uri.EscapeDataString(
        Url.Action("Ledger", "Customers", new { id = Model.Customer.Id }) ?? $"/Customers/Ledger/{Model.Customer.Id}");
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h4 class="text-primary mb-1">@Model.Customer.BuyerName</h4>
        <p class="text-muted mb-0">
            <code>@Model.Customer.BuyerId</code>
            @if (!string.IsNullOrEmpty(Model.Customer.NTN))
            {
                <span class="ms-2">NTN: @Model.Customer.NTN</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button type="button" class="btn btn-outline-primary btn-sm" id="btn-print-ledger">
            <i class="fa-solid fa-print me-1"></i>Print
        </button>
        <button type="button" class="btn btn-outline-success btn-sm" id="btn-share-ledger"
                data-party-type="customer" data-party-id="@Model.Customer.Id">
            <i class="fa-solid fa-share-nodes me-1"></i>Share
        </button>
        <a asp-action="Statement" asp-route-id="@Model.Customer.Id" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-file-lines me-1"></i>Statement
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="ledger-print-area">
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card card-kpi p-3">
            <div class="kpi-label">Opening Balance</div>
            <div class="kpi-value text-currency">@Model.Customer.OpeningBalance.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-kpi p-3">
            <div class="kpi-label">Current Balance</div>
            <div class="kpi-value text-currency">@Model.ClosingBalance.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Reference</th>
                    <th>Description</th>
                    <th class="text-end">Debit</th>
                    <th class="text-end">Credit</th>
                    <th class="text-end">Pending</th>
                    <th class="text-end">Balance</th>
                    <th class="no-print">Documents</th>
                    @if (showRowActions)
                    {
                        <th class="no-print text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr><td colspan="@(showRowActions ? 9 : 8)" class="text-muted text-center">No ledger entries yet.</td></tr>
                }
                else
                {
                    foreach (var entry in Model.Entries)
                    {
                        <tr class="@(entry.PendingCredit > 0 ? "table-warning" : null)">
                            <td>@(entry.Date == DateTime.MinValue ? "—" : entry.Date.ToString("dd/MM/yyyy"))</td>
                            <td>
                                @if (entry.ReceiptId.HasValue && canOpenReceipt)
                                {
                                    <a href="/CustomerReceipts?edit=@entry.ReceiptId.Value&amp;returnUrl=@receiptReturnUrl"
                                       class="text-decoration-none"
                                       title="@(canEditReceipt ? "Edit receipt" : "View receipt")">
                                        <code>@entry.Reference</code>
                                    </a>
                                }
                                else if (entry.InvoiceId.HasValue && canViewInvoice)
                                {
                                    <a href="/SalesInvoices/Details/@entry.InvoiceId.Value"
                                       class="text-decoration-none"
                                       title="View invoice">
                                        <code>@entry.Reference</code>
                                    </a>
                                }
                                else
                                {
                                    <code>@entry.Reference</code>
                                }
                            </td>
                            <td>@entry.Description</td>
                            <td class="text-end text-currency">@(entry.Debit > 0 ? entry.Debit.ToString("N2") : "—")</td>
                            <td class="text-end text-currency">@(entry.Credit > 0 ? entry.Credit.ToString("N2") : "—")</td>
                            <td class="text-end text-currency text-muted">@(entry.PendingCredit > 0 ? entry.PendingCredit.ToString("N2") : "—")</td>
                            <td class="text-end text-currency fw-semibold">@entry.Balance.ToString("N2")</td>
                            <td class="no-print">
                                @if (entry.Attachments is { Count: > 0 })
                                {
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        @foreach (var doc in entry.Attachments)
                                        {
                                            <span class="d-inline-flex align-items-center gap-1">
                                                <a class="btn btn-link btn-sm p-0 text-primary"
                                                   href="/api/customers/receipt-attachments/@doc.Id/download"
                                                   target="_blank"
                                                   title="View @doc.FileName">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                                <a class="btn btn-link btn-sm p-0 text-secondary"
                                                   href="/api/customers/receipt-attachments/@doc.Id/download?download=1"
                                                   title="Download @doc.FileName">
                                                    <i class="fa-solid fa-download"></i>
                                                </a>
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            @if (showRowActions)
                            {
                                <td class="no-print text-end text-nowrap">
                                    @if (entry.InvoiceId.HasValue && canViewInvoice)
                                    {
                                        <a href="/SalesInvoices/Details/@entry.InvoiceId.Value"
                                           class="btn btn-link btn-sm p-0 me-1"
                                           title="View invoice">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        @if (entry.CanShareInvoice)
                                        {
                                            <button type="button"
                                                    class="btn btn-link btn-sm p-0 text-success js-share-invoice"
                                                    data-id="@entry.InvoiceId.Value"
                                                    title="Share invoice">
                                                <i class="fa-solid fa-share-nodes"></i>
                                            </button>
                                        }
                                    }
                                    else if (entry.ReceiptId.HasValue && canOpenReceipt)
                                    {
                                        <a href="/CustomerReceipts?edit=@entry.ReceiptId.Value&amp;returnUrl=@receiptReturnUrl"
                                           class="btn btn-link btn-sm p-0 me-1"
                                           title="@(canEditReceipt ? "View / edit receipt" : "View receipt")">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-link btn-sm p-0 me-1 js-print-receipt"
                                                data-id="@entry.ReceiptId.Value"
                                                title="Print / PDF">
                                            <i class="fa-solid fa-print"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-link btn-sm p-0 text-success js-share-receipt"
                                                data-id="@entry.ReceiptId.Value"
                                                title="Share receipt">
                                            <i class="fa-brands fa-whatsapp"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
            @if (Model.Entries.Count > 0)
            {
                var movementEntries = Model.Entries
                    .Where(e => e.Reference is not ("OPENING" or "B/F"))
                    .ToList();
                var totalDebit = movementEntries.Sum(e => e.Debit);
                var totalCredit = movementEntries.Sum(e => e.Credit);
                <tfoot>
                    <tr class="table-light fw-semibold">
                        <th colspan="3" class="text-end">Totals</th>
                        <th class="text-end text-currency">@totalDebit.ToString("N2")</th>
                        <th class="text-end text-currency">@totalCredit.ToString("N2")</th>
                        <th class="text-end text-currency text-muted">@(movementEntries.Sum(e => e.PendingCredit) > 0 ? movementEntries.Sum(e => e.PendingCredit).ToString("N2") : "—")</th>
                        <th class="text-end text-currency">@Model.ClosingBalance.ToString("N2")</th>
                        <th class="no-print"></th>
                        @if (showRowActions)
                        {
                            <th class="no-print"></th>
                        }
                    </tr>
                    <tr class="table-light">
                        <th colspan="6" class="text-end">Closing Balance</th>
                        <th class="text-end text-currency">@Model.ClosingBalance.ToString("N2")</th>
                        <th class="no-print"></th>
                        @if (showRowActions)
                        {
                            <th class="no-print"></th>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
</div>

<partial name="_PrintChoiceModal" />
<partial name="_LedgerShareModal" />
<partial name="~/Views/SalesInvoices/_InvoiceShareModal.cshtml" />
<partial name="_ReceiptShareModal" />

@section Scripts {
    <script src="~/js/modules/print-choice.js" asp-append-version="true"></script>
    <script src="~/js/modules/ledger-share.js" asp-append-version="true"></script>
    <script src="~/js/modules/sales-invoice-share.js" asp-append-version="true"></script>
    <script src="~/js/modules/customer-receipt-share.js" asp-append-version="true"></script>
    <script src="~/js/modules/ledger-row-share.js" asp-append-version="true"></script>
    <script>
        document.getElementById('btn-print-ledger').addEventListener('click', function () {
            if (window.PrintChoice) {
                window.PrintChoice.open({
                    title: 'Print customer ledger',
                    summary: 'Choose Print for the printer dialog, or Save as PDF to download the ledger PDF.',
                    onPrint: function () { window.print(); },
                    onPdf: function () {
                        window.open('/api/customers/@Model.Customer.Id/ledger-pdf', '_blank');
                    }
                });
                return;
            }
            window.print();
        });
        document.getElementById('btn-share-ledger').addEventListener('click', function () {
            window.LedgerShare.open({
                partyType: 'customer',
                partyId: @Model.Customer.Id
            });
        });
    </script>
}
