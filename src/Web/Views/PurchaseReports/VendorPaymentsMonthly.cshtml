@{
    ViewData["Title"] = "Vendor Payments (Monthly)";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3 no-print">
    <div>
        <h4 class="text-primary mb-1">Vendor Payments (Monthly)</h4>
        <p class="text-muted small mb-0">Payments are shown in the month of the bills they clear.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm" id="btn-print-report">
            <i class="fa-solid fa-print me-1"></i>Print / Save PDF
        </button>
        <button type="button" class="btn btn-success btn-sm" id="btn-whatsapp-report">
            <i class="fa-brands fa-whatsapp me-1"></i>WhatsApp
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div id="report-company-warning" class="alert alert-warning d-none mb-3 no-print"></div>

<div class="card p-3 mb-3 no-print">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="filter-from">From Date</label>
            <input type="date" class="form-control" id="filter-from" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="filter-to">To Date</label>
            <input type="date" class="form-control" id="filter-to" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="filter-vendor">Vendor</label>
            <select class="form-select select2" id="filter-vendor">
                <option value="">All vendors</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-primary w-100" id="btn-load-report">
                <i class="fa-solid fa-magnifying-glass me-1"></i>Load
            </button>
        </div>
    </div>
</div>

<div class="card p-3 report-print-area report-print-landscape" id="report-content">
    <div class="text-center mb-4">
        <h5 class="text-primary mb-1">Vendor Payments (Monthly)</h5>
        <p class="text-muted small mb-0" id="report-period">Select dates and click Load</p>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Payment #</th>
                    <th>Vendor</th>
                    <th>Type</th>
                    <th>Method</th>
                    <th class="text-end">Amount</th>
                    <th>Ref #</th>
                    <th class="text-end">Applied</th>
                </tr>
            </thead>
            <tbody id="report-lines">
                <tr><td colspan="8" class="text-muted text-center">No data loaded.</td></tr>
            </tbody>
            <tfoot id="report-footer" class="d-none table-light">
                <tr>
                    <th colspan="5" class="text-end">Grand Total</th>
                    <th class="text-end" id="report-total-amount">0.00</th>
                    <th colspan="2"></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/report-print.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/modules/report-print-common.js" asp-append-version="true"></script>
    <script src="~/js/modules/purchase-report-vendor-payments-monthly.js" asp-append-version="true"></script>
}
