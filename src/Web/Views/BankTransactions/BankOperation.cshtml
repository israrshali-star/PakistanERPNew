@using PakistanAccountingERP.Application.Interfaces.Services
@using PakistanAccountingERP.Domain.Enums
@inject IPermissionService PermissionService
@{
    var transactionType = (BankTransactionType)ViewData["TransactionType"]!;
    var title = ViewData["Title"]?.ToString() ?? "Banking";
    var canCreate = await PermissionService.HasPermissionAsync("Banking.Create");
    var typeValue = (int)transactionType;
    var subtitle = transactionType switch
    {
        BankTransactionType.Withdrawal => "Pay customers, vendors, or Cash in Hand. Use Cash Withdrawal to move funds from bank to Cash in Hand by cheque.",
        BankTransactionType.Deposit => "Send in-clearing cheques to the bank. After the bank clears them, approve clearance in Customer Receipts to update the customer balance and bank account.",
        BankTransactionType.Transfer => "Move funds between Cash in Hand and bank accounts.",
        _ => string.Empty
    };
}

<div id="bank-op-permissions" class="d-none"
     data-can-create="@canCreate.ToString().ToLower()"
     data-transaction-type="@typeValue"></div>
<div id="bank-op-company-warning" class="alert alert-warning d-none mb-3"></div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="text-primary mb-0">@title</h4>
        <p class="text-muted small mb-0">@subtitle</p>
    </div>
</div>

@if (transactionType == BankTransactionType.Deposit)
{
    <div class="alert alert-info py-2 mb-3">
        <strong>Undeposited Funds (<span id="undeposited-account-number">10017</span>):</strong>
        PKR <span id="undeposited-balance">0.00</span> available to deposit.
    </div>
}

<div class="card p-3 mb-3">
    <form id="bank-op-form">
        <div class="row g-3">
            @if (transactionType == BankTransactionType.Transfer)
            {
                <div class="col-md-6">
                    <label class="form-label" for="op-from-account-id">From Account</label>
                    <select class="form-select select2" id="op-from-account-id" required>
                        <option value="">— Select account —</option>
                    </select>
                    <div class="form-text" id="op-from-balance"></div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="op-to-account-id">To Account</label>
                    <select class="form-select select2" id="op-to-account-id" required>
                        <option value="">— Select account —</option>
                    </select>
                    <div class="form-text" id="op-to-balance"></div>
                </div>
            }
            else if (transactionType == BankTransactionType.Deposit)
            {
                <div class="col-md-6">
                    <label class="form-label" for="op-bank-account-id">Deposit To Account (COA)</label>
                    <select class="form-select select2" id="op-bank-account-id" required>
                        <option value="">— Select bank or Cash in Hand —</option>
                    </select>
                    <div class="form-text" id="op-bank-balance"></div>
                </div>
            }

            @if (transactionType == BankTransactionType.Deposit)
            {
                <div class="col-12">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <label class="form-label mb-0">Undeposited Cheques</label>
                        <div class="small text-muted">
                            Selected total: <strong>PKR <span id="deposit-selected-total">0.00</span></strong>
                        </div>
                    </div>
                    <div class="table-responsive border rounded">
                        <table class="table table-sm table-hover mb-0" id="undeposited-cheques-table">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 2.5rem;">
                                        <input type="checkbox" class="form-check-input" id="deposit-select-all" title="Select all" />
                                    </th>
                                    <th>Customer</th>
                                    <th>Receipt #</th>
                                    <th>Cheque #</th>
                                    <th>Cheque Date</th>
                                    <th>Receipt Date</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody id="undeposited-cheques-body">
                                <tr id="undeposited-cheques-empty">
                                    <td colspan="7" class="text-center text-muted py-3">Loading undeposited cheques…</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (transactionType == BankTransactionType.Withdrawal)
            {
                <div class="col-md-4">
                    <label class="form-label" for="op-payment-method">Payment Method</label>
                    <select class="form-select" id="op-payment-method" required>
                        <option value="">— Select method —</option>
                        <option value="1">Cash</option>
                        <option value="2">Cheque</option>
                        <option value="3">Bank Transfer</option>
                        <option value="4">Cash Withdrawal</option>
                    </select>
                </div>
                <div class="col-md-8" id="op-pay-from-bank-wrap">
                    <label class="form-label" for="op-bank-account-id">Pay From — Bank Account (COA)</label>
                    <select class="form-select select2" id="op-bank-account-id">
                        <option value="">— Select account —</option>
                    </select>
                    <div class="form-text" id="op-bank-balance"></div>
                </div>
                <div class="col-md-8" id="op-pay-to-wrap">
                    <label class="form-label" for="op-counter-account-id">Pay To</label>
                    <select class="form-select select2" id="op-counter-account-id" required>
                        <option value="">— Select account —</option>
                    </select>
                    <div class="form-text" id="op-party-balance"></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="op-amount">Amount (PKR)</label>
                    <input type="number" class="form-control" id="op-amount" step="0.01" min="0.01" required />
                    <div class="form-text text-success" id="op-amount-words"></div>
                </div>
                <div class="col-md-6 d-none" id="op-cash-withdrawal-wrap">
                    <label class="form-label">Pay To — Cash in Hand</label>
                    <div class="form-control bg-light" id="op-cash-withdrawal-label">Cash in Hand (10015)</div>
                    <div class="form-text" id="op-cash-withdrawal-balance"></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="op-date">Date</label>
                    <input type="date" class="form-control" id="op-date" required />
                </div>
                <div class="col-md-8" id="op-cheque-fields">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="op-cheque-number">Cheque #</label>
                            <input type="text" class="form-control" id="op-cheque-number" maxlength="50" />
                            <div class="form-text" id="op-cheque-number-hint">Auto-increments after each posted cheque.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="op-cheque-date">Cheque Date</label>
                            <input type="date" class="form-control" id="op-cheque-date" />
                        </div>
                    </div>
                </div>
                <div class="col-12 d-none" id="cheque-live">
                    <div class="border rounded p-3">
                        <div class="fw-semibold mb-1">On the cheque</div>
                        <p class="small mb-2">Tick one name. Cash writes Cash. Party name writes the account selected in Pay To. Other name writes the text you type.</p>
                        <div class="d-flex flex-wrap gap-4 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="cheque-payee-cash" value="cash" />
                                <label class="form-check-label" for="cheque-payee-cash">Cash</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="cheque-payee-party" value="party" checked />
                                <label class="form-check-label" for="cheque-payee-party" id="cheque-payee-party-label">Party name</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="cheque-payee-text" value="text" />
                                <label class="form-check-label" for="cheque-payee-text">Other name</label>
                            </div>
                            <div class="w-100 d-none" id="cheque-payee-text-wrap">
                                <label class="form-label small mb-1" for="cheque-payee-text-input">Name written on the cheque</label>
                                <input type="text" class="form-control" id="cheque-payee-text-input" maxlength="80" autocomplete="off" />
                            </div>
                        </div>
                        <p class="small mb-2" id="cheque-live-effect">The name, date, amount, and words appear on the Meezan cheque as you type.</p>
                        <div class="cheque-preview-wrap mb-3">
                            <div class="cheque-preview-leaf">
                                <div class="cheque-preview-cross">A/C PAYEE ONLY</div>
                                <div class="cheque-preview-dates"></div>
                                <div class="cheque-preview-rule cheque-preview-pay-rule"></div>
                                <div class="cheque-preview-rule cheque-preview-word-rule-1"></div>
                                <div class="cheque-preview-rule cheque-preview-word-rule-2"></div>
                                <div class="cheque-preview-box cheque-preview-amount-box"></div>
                                <div class="cheque-preview-payee"></div>
                                <div class="cheque-preview-words cheque-preview-words-1"></div>
                                <div class="cheque-preview-words cheque-preview-words-2"></div>
                                <div class="cheque-preview-figures"></div>
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-sm-6 col-lg-3">
                                <label class="form-label small mb-1" for="cheque-date-x">Date right (mm)</label>
                                <input type="number" class="form-control form-control-sm" id="cheque-date-x" step="0.5" min="-60" max="60" value="0" />
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <label class="form-label small mb-1" for="cheque-date-y">Date down (mm)</label>
                                <input type="number" class="form-control form-control-sm" id="cheque-date-y" step="0.5" min="-60" max="60" value="0" />
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <label class="form-label small mb-1" for="cheque-pay-x">Pay and words right (mm)</label>
                                <input type="number" class="form-control form-control-sm" id="cheque-pay-x" step="0.5" min="-60" max="60" value="0" />
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <label class="form-label small mb-1" for="cheque-pay-y">Pay and words down (mm)</label>
                                <input type="number" class="form-control form-control-sm" id="cheque-pay-y" step="0.5" min="-60" max="60" value="0" />
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-3 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="cheque-orientation" id="cheque-orientation-landscape" value="landscape" checked />
                                <label class="form-check-label" for="cheque-orientation-landscape">Landscape</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="cheque-orientation" id="cheque-orientation-portrait" value="portrait" />
                                <label class="form-check-label" for="cheque-orientation-portrait">Portrait</label>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (transactionType == BankTransactionType.Deposit)
            {
                <div class="col-md-4">
                    <label class="form-label" for="op-date">Deposit Date</label>
                    <input type="date" class="form-control" id="op-date" required />
                </div>
            }
            else if (transactionType != BankTransactionType.Withdrawal)
            {
                <div class="col-md-4">
                    <label class="form-label" for="op-date">Date</label>
                    <input type="date" class="form-control" id="op-date" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="op-amount">Amount (PKR)</label>
                    <input type="number" class="form-control" id="op-amount" step="0.01" min="0.01" required />
                    <div class="form-text text-success" id="op-amount-words"></div>
                </div>
            }
            <div class="col-12">
                <label class="form-label" for="op-description">Description / Memo</label>
                <textarea class="form-control" id="op-description" rows="2" maxlength="500"></textarea>
            </div>
        </div>
        <div class="alert alert-success d-none mt-3" id="bank-op-form-success"></div>
        <div class="alert alert-danger d-none mt-3" id="bank-op-form-error"></div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary" id="btn-save-bank-op" permission="Banking.Create">
                <i class="fa-solid fa-check me-1"></i>Post @title
            </button>
        </div>
    </form>
</div>

<div class="card p-3">
    <h6 class="text-primary mb-3">Recent @title Activity</h6>
    <div class="table-responsive">
        <table class="table table-hover w-100" id="bank-op-table">
            <thead>
                <tr>
                    <th>Account</th>
                    <th>Date</th>
                    @if (transactionType == BankTransactionType.Transfer)
                    {
                        <th>To Account</th>
                    }
                    else if (transactionType == BankTransactionType.Withdrawal)
                    {
                        <th>Pay To</th>
                        <th>Method</th>
                        <th>Cheque #</th>
                    }
                    <th class="text-end">Amount</th>
                    <th>Description</th>
                    @if (transactionType == BankTransactionType.Withdrawal)
                    {
                        <th class="text-end">Print</th>
                    }
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@if (transactionType == BankTransactionType.Withdrawal)
{
    <div class="modal fade" id="chequePrintModal" tabindex="-1" aria-labelledby="chequePrintModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-primary" id="chequePrintModalLabel">Print cheque</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2" id="cheque-print-summary"></p>
                    <p class="text-muted small mb-2">Tick Cash, the party name, or Other name. The date goes in the eight boxes, that name on the Pay line, the amount in the PKR box, and the words on the Rupees lines. You still sign it.</p>
                    <div class="d-flex flex-wrap gap-4 mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="modal-cheque-payee-cash" value="cash" />
                            <label class="form-check-label" for="modal-cheque-payee-cash">Cash</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="modal-cheque-payee-party" value="party" checked />
                            <label class="form-check-label" for="modal-cheque-payee-party" id="modal-cheque-payee-party-label">Party name</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="modal-cheque-payee-text" value="text" />
                            <label class="form-check-label" for="modal-cheque-payee-text">Other name</label>
                        </div>
                        <div class="w-100 d-none" id="modal-cheque-payee-text-wrap">
                            <label class="form-label small mb-1" for="modal-cheque-payee-text-input">Name written on the cheque</label>
                            <input type="text" class="form-control" id="modal-cheque-payee-text-input" maxlength="80" autocomplete="off" />
                        </div>
                    </div>
                    <div class="cheque-preview-wrap mb-2" id="cheque-preview-wrap">
                        <div class="cheque-preview-leaf" id="cheque-preview-leaf">
                            <div class="cheque-preview-cross">A/C PAYEE ONLY</div>
                            <div class="cheque-preview-dates"></div>
                            <div class="cheque-preview-rule cheque-preview-pay-rule"></div>
                            <div class="cheque-preview-rule cheque-preview-word-rule-1"></div>
                            <div class="cheque-preview-rule cheque-preview-word-rule-2"></div>
                            <div class="cheque-preview-box cheque-preview-amount-box"></div>
                            <div class="cheque-preview-payee"></div>
                            <div class="cheque-preview-words cheque-preview-words-1"></div>
                            <div class="cheque-preview-words cheque-preview-words-2"></div>
                            <div class="cheque-preview-figures"></div>
                        </div>
                    </div>
                    <p class="small mb-2" id="cheque-modal-effect"></p>
                    <p class="text-muted small mb-0">Paper A4, same landscape or portrait, margins None, scale 100. The positions are the ones on the Write Cheque page.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Skip</button>
                    <button type="button" class="btn btn-primary" id="btn-print-cheque-leaf">
                        <i class="fa-solid fa-print me-1"></i>Print cheque
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (transactionType == BankTransactionType.Withdrawal)
    {
        <script src="~/js/modules/print-choice.js" asp-append-version="true"></script>
    }
    <script src="~/js/modules/banking-operations.js" asp-append-version="true"></script>
}
